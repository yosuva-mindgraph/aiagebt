config.js
proxy/.env
node_modules/
shots/

# The pre-rendered speech, and the cache it is packed from. GENERATED by
# tools/prerender-voice.mjs, which needs the key in config.js — so neither of
# these is a source, and both are reproducible from a script plus a key. Exactly
# the reasoning that keeps dist/index-3d.html out: assets/voice-clips.js is ~13 MB
# of base64 whose every byte would land in history again on any script edit, and
# .voice-cache/ is the same audio a second time, unpacked. Rebuild instead:
#     node tools/prerender-voice.mjs   (once, with a key, on the machine)
assets/voice-clips.js
.voice-cache/
# dist/index.html is committed on purpose — it is the thing you double-click
# vendor/talkinghead.bundle.js and assets/avatar.glb are committed for the same
# reason: the booth machine has no npm and no network. `npm ci` is how you
# regenerate the bundle, never how you obtain it. See docs/TALKINGHEAD.md

# …but dist/index-3d.html is NOT committed. It is the same page with the 0.79 MiB
# vendor bundle and the base64 of a 7.04 MiB GLB inlined into it — ~10.2 MiB of
# generated bytes that are ALREADY in git, twice, in their real form. Committing
# it would put a third copy in every clone and a fresh 10 MB blob in history on
# every avatar tweak. Rebuild it instead, in one second, from the two sources
# that ARE tracked:   node build.js --3d
dist/index-3d.html
